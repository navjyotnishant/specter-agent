# Optional overrides. Every one has a working default — Specter runs with no
# .env at all.

# Where state lives. Relocates the database, run worktrees, the runner token and
# the approved-workspace list together. docker-compose reads the same variable,
# so the container and the CLI resolve to one directory.
# SPECTER_HOME=~/.specter

# Points at a specific database file, overriding SPECTER_HOME for this one path.
# SDLC_DATABASE_PATH=/app/data/app.db

# Refuse to run an agent when no OS confinement mechanism is available, instead
# of warning and continuing unconfined.
# SPECTER_REQUIRE_CONFINEMENT=1

# Linear integration — set to enable automatic failure logging.
# LINEAR_API_TOKEN=
# LINEAR_TEAM_ID=SPE
# LINEAR_PROJECT_NAME=specter-agent
