<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.specter-agent.host-runner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>PLIST_DIR/specter_host_runner_launcher.sh</string>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/specter-host-runner.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/specter-host-runner.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Written where the containerized backend can also read it. -->
        <key>SPECTER_RUNNER_TOKEN_FILE</key>
        <string>/Users/navjyotnishant/Desktop/github/navjyotnishant/specter-agent/secrets/runner-token</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
