  {
    "id": "builtin-pre-push-review",
    "name": "Pre-Push Review",
    "description": "Correctness and test-coverage review of the current change, gated on a human approval before anything is reported as ready to push.",
    "graph": {
      "nodes": [
        {
          "id": "trigger",
          "type": "trigger",
          "data": {
            "label": "Change to review",
            "fieldName": "input"
          }
        },
        {
          "id": "correctness",
          "type": "specialistAgent",
          "data": {
            "label": "Correctness",
            "role": "specialist",
            "objective": "Review the change as a pre-landing gate: logic bugs, regressions, missing validation. Split findings into Blockers and Nits.",
            "selectedSkills": [
              "pr-readiness-review"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "tests",
          "type": "specialistAgent",
          "data": {
            "label": "Test Coverage",
            "role": "specialist",
            "objective": "Identify code paths the change touches that no test would catch if they broke.",
            "selectedSkills": [
              "test-gap-analysis"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "gate",
          "type": "humanApproval",
          "data": {
            "label": "Approve to push",
            "reason": "Both reviews are in. Approving marks this change cleared to push; rejecting cancels the run.",
            "timeoutHours": 24
          }
        },
        {
          "id": "report",
          "type": "specialistAgent",
          "data": {
            "label": "Verdict",
            "role": "specialist",
            "objective": "Write the final verdict from the two reviews above. State READY or NOT READY in the first line.",
            "selectedSkills": [
              "standard-report-format"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "trigger",
          "target": "correctness"
        },
        {
          "id": "e2",
          "source": "trigger",
          "target": "tests"
        },
        {
          "id": "e3",
          "source": "correctness",
          "target": "gate"
        },
        {
          "id": "e4",
          "source": "tests",
          "target": "gate"
        },
        {
          "id": "e5",
          "source": "gate",
          "target": "report"
        }
      ]
    }
  },
