#!/usr/bin/env bash
# Specter Agent pre-commit gate — real enforcement layer.
#
# Runs a Specter Agent workflow against this repo and blocks the commit if it
# fails. Uses the existing scripts/specter-agent CLI wrapper directly: a git
# hook is executed by git itself (not by a coding assistant's tool-use loop),
# so the long-blocking nature of the CLI call is not a problem here — git
# natively waits for the hook process to exit before continuing the commit.
#
# Setup (once per repo):
#   1. Copy this file to .git/hooks/pre-commit in the target repository
#      (or point a hook manager such as pre-commit/husky at it) and
#      `chmod +x .git/hooks/pre-commit`.
#   2. Set SPECTER_WORKFLOW_ID (and SPECTER_TOKEN / SPECTER_API_BASE_URL if
#      not already configured for scripts/specter-agent) in your shell
#      profile or a local .env — never commit tokens to source control.
#   3. Register this repository's path as an approved workspace in Specter
#      (Connectors / Workspaces page in the web UI).
#
# SPECTER_AGENT_BIN may point at a vendored copy of scripts/specter-agent if
# it isn't installed globally.

set -euo pipefail

if [ -z "${SPECTER_WORKFLOW_ID:-}" ]; then
  echo "SPECTER_WORKFLOW_ID is not set — skipping Specter pre-commit gate." >&2
  echo "Set it to enable this check. See scripts/precommit-gate/SKILL.md." >&2
  exit 0
fi

SPECTER_AGENT_BIN="${SPECTER_AGENT_BIN:-specter-agent}"

if ! command -v "$SPECTER_AGENT_BIN" >/dev/null 2>&1; then
  echo "Specter pre-commit gate: '$SPECTER_AGENT_BIN' not found on PATH." >&2
  echo "Set SPECTER_AGENT_BIN to the full path of scripts/specter-agent, or install it." >&2
  exit 1
fi

echo "Specter pre-commit gate: running workflow '$SPECTER_WORKFLOW_ID'..." >&2
"$SPECTER_AGENT_BIN" "$SPECTER_WORKFLOW_ID" --workspace . --quiet
