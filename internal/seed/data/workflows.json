[
  {
    "id": "builtin-security-review-team",
    "name": "Security Review Team",
    "description": "A supervisor fans work out to three security specialists — code, dependencies, secrets — then a report writer merges their findings into one severity-ordered report.",
    "graph": {
      "nodes": [
        {
          "id": "trigger",
          "type": "trigger",
          "data": {
            "label": "What to review",
            "fieldName": "input"
          }
        },
        {
          "id": "supervisor",
          "type": "supervisorAgent",
          "data": {
            "label": "Review Lead",
            "role": "supervisor",
            "objective": "Split the requested security review across the three specialists below and hand each one the part of the codebase it should inspect.",
            "delegationStrategy": "parallel",
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "code",
          "type": "specialistAgent",
          "data": {
            "label": "Code Security",
            "role": "specialist",
            "objective": "Run the secure code review checklist over the code in scope.",
            "selectedSkills": [
              "secure-code-review"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "deps",
          "type": "specialistAgent",
          "data": {
            "label": "Dependency Risk",
            "role": "specialist",
            "objective": "Audit the dependency manifests for risky, unpinned, abandoned, or typosquatted packages.",
            "selectedSkills": [
              "dependency-risk-review"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "secrets",
          "type": "specialistAgent",
          "data": {
            "label": "Secrets & Config",
            "role": "specialist",
            "objective": "Look for committed credentials and insecure configuration defaults.",
            "selectedSkills": [
              "secrets-config-review"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        },
        {
          "id": "report",
          "type": "specialistAgent",
          "data": {
            "label": "Report Writer",
            "role": "specialist",
            "objective": "Merge every specialist's findings into one report. Do not re-review the code — the findings above are your only input.",
            "selectedSkills": [
              "standard-report-format"
            ],
            "runtime": "direct",
            "sandboxAgent": "claude"
          }
        }
